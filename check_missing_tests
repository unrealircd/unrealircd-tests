#!/bin/bash
if [ "$TESTS_UNREALIRCD_DIR" = "" ]; then
	TESTS_UNREALIRCD_DIR="$HOME/unrealircd"
fi

if [ ! -f "$TESTS_UNREALIRCD_DIR/data/cmds.txt" ]; then
	echo "File $TESTS_UNREALIRCD_DIR/data/cmds.txt not found"
	echo "This means the 'third/dumpcmds' module was not loaded"
	echo "or the ircd is not running."
	exit 1
fi

cat "$TESTS_UNREALIRCD_DIR/data/cmds.txt"|\
grep 'USER'|\
grep -v 'ALIAS'|\
awk '{ print $1 }'|\
tr '[A-Z]' '[a-z]'|\
while read cmd
do
	if [ ! -f "tests/usercommands/$cmd" -a ! -f "tests/opercommands/$cmd" ]; then
		echo "MISSING: tests/usercommands/$cmd"
	fi
done

cat "$TESTS_UNREALIRCD_DIR/data/cmds.txt"|\
grep 'OPER'|\
grep -v 'ALIAS'|\
awk '{ print $1 }'|\
tr '[A-Z]' '[a-z]'|\
while read cmd
do
	if [ ! -f "tests/opercommands/$cmd" ]; then
		echo "MISSING: tests/opercommands/$cmd"
	fi
done
