#!/usr/bin/python3
import irctestframework.irctest

m = irctestframework.irctest.IrcTest()
c1a = m.new('c1a')
m.connect()

PASS = "Your vhost is now"
FAIL = "No vHost lines available"

# Just connected — idle time should be very low, well under 300 seconds
m.send(c1a, "VHOST crule_idle_time test")
m.expect(c1a, "idle_time() < 300 should match for freshly connected client", PASS)
m.clearlog()
print

# Negative: idle_time() > 99999 — freshly connected client can't be this idle
m.send(c1a, "VHOST crule_idle_time_neg test")
m.expect(c1a, "idle_time() > 99999 should NOT match for freshly connected client", FAIL)
m.clearlog()
print
