#!/usr/bin/python3
import irctestframework.irctest

m = irctestframework.irctest.IrcTest()
c1a = m.new('c1a')
m.connect()

PASS = "Your vhost is now"
FAIL = "No vHost lines available"

# Not in #cruletest — should NOT match
m.send(c1a, "VHOST crule_in_channel test")
m.expect(c1a, "in_channel('#cruletest') should NOT match before JOIN", FAIL)
m.clearlog()
print

# Join — should match
m.send(c1a, "JOIN #cruletest")
m.clearlog()
m.send(c1a, "VHOST crule_in_channel test")
m.expect(c1a, "in_channel('#cruletest') should match after JOIN", PASS)
m.clearlog()
print
