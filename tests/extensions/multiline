print("=== 10. STATUSMSG Prefix (@#channel) ===")

# c1k joins and gets opped by c1a (channel creator)
m.send(c1k, "JOIN " + chan)
m.clearlog()
m.send(c1a, "MODE " + chan + " +o " + c1k.nick)
m.clearlog()

# c1k (ops, multiline) sends multiline to @#channel
m.send(c1k, [
    "BATCH +mls draft/multiline @" + chan,
    "@batch=mls PRIVMSG @" + chan + " :ops only line one",
    "@batch=mls PRIVMSG @" + chan + " :ops only line two",
    "BATCH -mls",
])

# c1a (ops, multiline) should receive the batch
m.expect(c1a, "c1a: STATUSMSG BATCH open",
         "BATCH \\+[^ ]+ draft/multiline")
m.expect(c1a, "c1a: STATUSMSG line one",
         "@batch=.*PRIVMSG.*:ops only line one")
m.expect(c1a, "c1a: STATUSMSG line two",
         "@batch=.*PRIVMSG.*:ops only line two")
m.expect(c1a, "c1a: STATUSMSG BATCH close",
         "BATCH -")

# c2a (no ops, plain) should NOT receive anything
m.not_expect(c2a, "c2a: no STATUSMSG delivery to non-opped plain client",
             "ops only line")

# c2b (no ops, multiline) should NOT receive anything
m.not_expect(c2b, "c2b: no STATUSMSG delivery to non-opped multiline client",
             "ops only line")
